# --- Bildirim Kanalı ---
# whatsapp: Doğrudan WhatsApp sohbetinize görsel ve tutar özeti gönderir (ÜCRETSİZ, Twilio ve S3 gerektirmez)
# twilio: SMS üzerinden link gönderir (Twilio hesabı ve AWS S3 gerektirir)
NOTIFICATION_CHANNEL=whatsapp

# Bildirimin iletileceği telefon numarası (ör. +905xxxxxxxxx).
# 'self' yazarsanız veya boş bırakırsanız doğrudan kendi WhatsApp sohbetinize ("Kendime Not") gönderir.
ALERT_DESTINATION_NUMBER=self

# --- WhatsApp ---
# Grup ID'sini bulmak için: npm run groups
TARGET_GROUP_ID=120363xxxxxxxxxxxx@g.us
SESSION_DATA_PATH=./.wwebjs_auth
# Bildirimlerde görünen grup adı
GROUP_LABEL=Muhasebe
HEARTBEAT_INTERVAL_MINUTES=15
HEARTBEAT_TIMEOUT_SECONDS=30

# --- PDF ayrıştırma ---
PDF_TARGET_REGEX=(?i)(toplam\s*tutar|odenecek\s*tutar|odenecek|tutar|aidat|total\s*due|amount\s*payable)
PDF_RENDER_SCALE=3
PDF_CROP_PADDING_PX=20
DEBUG_SMS_ON_NO_MATCH=false
DATA_DIR=./data

# --- Opsiyonel: Twilio & AWS S3 (yalnızca NOTIFICATION_CHANNEL=twilio ise gereklidir) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1234567890
# AWS_S3_BUCKET_NAME=pdf-evidence-vault
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxx
# EVIDENCE_URL_MODE=public
