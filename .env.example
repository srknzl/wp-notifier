# --- Telefon (Twilio) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890
ALERT_DESTINATION_NUMBER=+905xxxxxxxxx

# --- WhatsApp ---
# Grup ID'sini bulmak için: npm run groups
TARGET_GROUP_ID=120363xxxxxxxxxxxx@g.us
SESSION_DATA_PATH=./.wwebjs_auth
# SMS'lerde görünen grup adı (ASCII'ye çevrilir)
GROUP_LABEL=Muhasebe
# Sistem Chromium'u kullanılacaksa (Docker'da otomatik ayarlı)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
HEARTBEAT_INTERVAL_MINUTES=15
HEARTBEAT_TIMEOUT_SECONDS=30

# --- Bulut depolama (AWS S3) ---
AWS_S3_BUCKET_NAME=pdf-evidence-vault
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
# public: kalıcı link (bucket policy ile evidence/* okunabilir olmalı)
# presigned: süreli link, ama ~500 karakter olur ve SMS 160'ı aşar
EVIDENCE_URL_MODE=public
# SMS'in 160 karakterde kalması için kısa alan adı önerilir (ör. CloudFront): https://e.ornek.com
# EVIDENCE_PUBLIC_BASE_URL=
# Bucket ACL'leri açıksa ve policy yerine ACL isteniyorsa: public-read
# AWS_S3_OBJECT_ACL=
# EVIDENCE_PRESIGN_EXPIRY_SECONDS=604800

# --- PDF ayrıştırma ---
PDF_TARGET_REGEX=(?i)(total\s*due|amount\s*payable)
PDF_RENDER_SCALE=3
PDF_CROP_PADDING_PX=20
# Eşleşme bulunamayınca da bilgi SMS'i atılsın mı
DEBUG_SMS_ON_NO_MATCH=false
DATA_DIR=./data
